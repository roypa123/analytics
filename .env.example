# Variables for docker-compose.yml (repo root). Same names work two ways:
#   - Local:   cp .env.example .env, fill in real values — Compose auto-loads
#              this file for the ${VAR} substitution in docker-compose.yml.
#   - Dokploy: paste these same KEY=VALUE lines into the app's Environment
#              Variables UI — no file needed there, Dokploy sets them as real
#              environment variables and ${VAR} picks them up the same way.

ENVIRONMENT=local

# Already-hosted Postgres/Redis — this compose file runs no database
# containers of its own.
DATABASE__DSN=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE__SYNC_DSN=postgresql+psycopg://user:password@host:5432/dbname
DATABASE__POOL_SIZE=5

REDIS__URL=redis://user:password@host:6379/0

# openssl genpkey -algorithm ed25519  /  openssl pkey -in <that> -pubout
SECURITY__JWT_PRIVATE_KEY=
SECURITY__JWT_PUBLIC_KEY=
SECURITY__ACCESS_TOKEN_TTL_MINUTES=15
SECURITY__REFRESH_TOKEN_TTL_DAYS=30
# openssl rand -hex 32
SECURITY__VISITOR_HASH_SECRET=

INGESTION__FLUSH_INTERVAL_MS=500
INGESTION__FLUSH_MAX_ROWS=1000
INGESTION__SESSION_TIMEOUT_MINUTES=30

ANALYTICS__RAW_EVENT_RETENTION_DAYS=90
ANALYTICS__RAW_QUERY_RANGE_CAP_DAYS=7
ANALYTICS__GEOIP_COUNTRY_DB_PATH=

OBSERVABILITY__LOG_LEVEL=INFO

# Razorpay dashboard > Settings > API Keys; webhook secret from the webhook
# you configure pointing at POST /api/v1/billing/webhook.
RAZORPAY__KEY_ID=
RAZORPAY__KEY_SECRET=
RAZORPAY__WEBHOOK_SECRET=

# Comma-separated extra origins allowed to call analytics-backend, beyond the
# always-allowed localhost:5173. Required for any deployment — set this to
# wherever analytics-frontend is actually served from (matches
# VITE_API_BASE_URL/VITE_COLLECTOR_URL's host, just without the port split).
CORS__ALLOWED_ORIGINS=

# Browser-facing URLs — on Dokploy, set these to the deployed public
# hostnames for analytics-backend's two ports, not localhost.
VITE_API_BASE_URL=http://localhost:8000
VITE_COLLECTOR_URL=http://localhost:8001
VITE_ENVIRONMENT=local
