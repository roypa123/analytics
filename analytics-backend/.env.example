ENVIRONMENT=local

DATABASE__DSN=postgresql+asyncpg://analytics:analytics@localhost:5432/analytics
DATABASE__SYNC_DSN=postgresql+psycopg://analytics:analytics@localhost:5432/analytics
DATABASE__POOL_SIZE=5

REDIS__URL=redis://localhost:6379/0

SECURITY__JWT_PRIVATE_KEY=
SECURITY__JWT_PUBLIC_KEY=
SECURITY__ACCESS_TOKEN_TTL_MINUTES=15
SECURITY__REFRESH_TOKEN_TTL_DAYS=30
# openssl rand -hex 32
SECURITY__VISITOR_HASH_SECRET=

INGESTION__FLUSH_INTERVAL_MS=500
INGESTION__FLUSH_MAX_ROWS=1000
INGESTION__SESSION_TIMEOUT_MINUTES=30

ANALYTICS__RAW_EVENT_RETENTION_DAYS=90
ANALYTICS__RAW_QUERY_RANGE_CAP_DAYS=7
# Optional: path to a GeoLite2-Country.mmdb (or compatible) file. Empty means
# every event's geo columns are NULL — see Part 5 §5.4.
ANALYTICS__GEOIP_COUNTRY_DB_PATH=

OBSERVABILITY__LOG_LEVEL=INFO

# Part 12 (revised again: Orders, not Subscriptions) — no free tier, every
# workspace needs a captured payment within the last RAZORPAY__BILLING_PERIOD_DAYS.
# Get key id/secret from the Razorpay dashboard (Settings > API Keys); webhook
# secret comes from the webhook you configure there pointing at
# POST /api/v1/billing/webhook, subscribed to the payment.captured event.
RAZORPAY__KEY_ID=
RAZORPAY__KEY_SECRET=
RAZORPAY__WEBHOOK_SECRET=

# Comma-separated extra origins allowed to call this API, beyond the
# always-allowed localhost:5173 (Part 2 §2.3's CORS gate, app/api/main.py).
# Required for any deployment where the frontend isn't served from
# localhost:5173 — e.g. a VPS IP or a real domain.
CORS__ALLOWED_ORIGINS=
